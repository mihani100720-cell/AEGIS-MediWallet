# MEDIWALLET — Environment Variables
# Copy this file to .env and fill in real values. Do NOT commit .env to git.

# ── Security ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=mediwallet-super-secret-key-production-ready-2026

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./services/api/data/mediwallet.db
UPLOAD_DIR=./services/api/data/records

# ── OCR / AI ─────────────────────────────────────────────────────────────────
# Absolute or project-root-relative path to your downloaded Qwen2.5-VL model.
LOCAL_MODEL_DIR=models/medical-prescription-ocr-india

# Minimum free RAM (GB) before attempting local CPU model inference.
# The 7 GB model needs ~9–10 GB free. Set lower only if you have quantized weights.
OCR_RAM_THRESHOLD_GB=10.0

# Google Gemini API key for hosted Vision inference (Tier 2 fallback).
# Leave blank to skip the Gemini tier and go straight to TrOCR.
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
